# deploy/.env — variáveis do container Mercury PDV
# Copie este arquivo para ".env" (ao lado do docker-compose.yml) e preencha.
# NUNCA comite ou compartilhe o .env real.

# ── OBRIGATÓRIO ────────────────────────────────────────────────────────
# Pepper dos hashes de senha. Gere com:  openssl rand -hex 32
# ATENÇÃO: se este valor mudar ou se perder, TODOS os logins deixam de
# funcionar (os hashes ficam inválidos). Guarde uma cópia FORA da VPS.
LP_PEPPER=

# ── Opcionais (padrões já sensatos) ────────────────────────────────────
LP_AMBIENTE=producao
LP_BACKUP_INTERVALO_HORAS=6
LP_BACKUP_RETENCAO=30
LP_SESSAO_HORAS=12
LP_SESSAO_INATIVIDADE_MIN=30
TZ=America/Sao_Paulo
